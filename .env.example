# Copy to .env locally. Put real values in .env only, never in chat or Git.
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Tavily is the public web discovery source.
TAVILY_API_KEY=

# Optional fallbacks. Change LLM_PROVIDER and LLM_MODEL to use one.
# GROQ_API_KEY=
# OPENAI_API_KEY=

ENVIRONMENT=local
LOG_LEVEL=INFO
